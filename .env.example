OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
BRUNO_EVALUATION_API=decisions
PORT=5190
# Decisions uses gpt-6-luna for fast classification and frame selection.
# OPENAI_MODEL is the Responses fallback; set BRUNO_EVALUATION_API=responses
# for detailed prose reports (live: low reasoning; full-video: medium).
# Terse starts locally on port 7100.
# Agent Relay credentials are generated on first start and stored in the
# gitignored data/integrations/relay.json. Do not paste them into this UI.
# Optional: put downloaded robot videos in this dedicated inbox, with a matching
# .json sidecar containing task, criteria (array), and sourceUrl.
# BRUNO_DATA_DIR=/absolute/path/to/data

# Optional private Supabase archive. Apply supabase/migrations/*.sql first.
# Keep the secret on the server; never use a browser/publishable key here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also supported.
